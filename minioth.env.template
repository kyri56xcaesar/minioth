API_PORT=9090
IP=localhost
ISSUER=http://localhost:9090

# DB path/backend are chosen with CLI flags (-backend, -db-path), not here
# — see `minioth -h`.

# gin's run mode: "debug", "release" (default), or "test". Leave at
# release unless you're actively developing against this instance — debug
# prints every registered route and full stack traces on panic.
GIN_MODE=release

# Serve HTTPS directly instead of plain HTTP, for deployments that won't
# sit behind a TLS-terminating reverse proxy. Both or neither — leave both
# empty to keep the default plain-HTTP behavior.
TLS_CERT_FILE=
TLS_KEY_FILE=

# The one privileged account every backend seeds on first boot.
# ROOT_PASSWORD, if left empty, gets a random one generated and logged
# once at startup instead of defaulting to a fixed, guessable value — grep
# the startup log for "[SECURITY]" if you didn't set one and need it.
ROOT_USERNAME=root
ROOT_PASSWORD=

ALLOWED_ORIGINS=
ALLOWED_HEADERS=
ALLOWED_METHODS=

JWT_SECRET_KEY=
JWT_REFRESH_KEY=

# Access-token signing algorithm: HS256 (symmetric, default) or RS256
# (asymmetric). RS256 requires JWT_RSA_PRIVATE_KEY_PATH; its public key is
# then published live at /.well-known/jwks.json. Refresh tokens are always
# HS256 regardless of this setting (see jwt.go).
JWT_SIGNING_ALG=HS256
JWT_RSA_PRIVATE_KEY_PATH=

# Per-service credentials for the X-Service-Secret inter-service bypass
# (AuthMiddleware, see middleware.go): "service:secret,service2:secret2".
# Each service gets its own value so a leak or rotation only ever affects
# the one service it names, and requests are attributable to whichever
# service authenticated.
SERVICE_SECRETS=

HASH_COST=

# Password policy (all optional; defaults shown)
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72
PASSWORD_REQUIRE_UPPER=false
PASSWORD_REQUIRE_LOWER=false
PASSWORD_REQUIRE_DIGIT=false
PASSWORD_REQUIRE_SPECIAL=false

# Per-client-IP rate limit on register/login/passwd(-reset) — one shared
# budget across all of them, so spreading requests across those routes
# doesn't dodge the limit. RATE_LIMIT_RPS is the sustained rate;
# RATE_LIMIT_BURST is how many requests can arrive back-to-back before
# that sustained rate kicks in. Defaults shown.
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=10
